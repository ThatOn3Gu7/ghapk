#!/usr/bin/env python3
import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _phone
a = sys.argv[1:]
if a[:1] == ["package"] and len(a) == 2:
    st = _phone.load()
    if a[1] == "android":
        print("Package [android] (1):\n  versionCode=34 minSdk=34"); sys.exit(0)
    v = st.get(a[1])
    if not v:
        print("Unable to find package: " + a[1]); sys.exit(0)
    print("Packages:\n  Package [%s] (abc123):\n    versionCode=%d minSdk=24 targetSdk=34\n    versionName=%s\n"
          "    primaryCpuAbi=%s\n    signatures=PackageSignatures{def456 version:3, signatures:[%s], past signatures:[]}"
          % (a[1], v["versionCode"], v["versionName"], v["abi"], v["cert"]))
