#!/usr/bin/env python3
"""Pretend to open the package installer: after FAKE_INSTALL_DELAY seconds the
'user taps Install' and the phone's state changes to the APK's version."""
import sys, os, time, subprocess
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _phone
apk = sys.argv[-1]
if os.environ.get("FAKE_NO_OPEN") == "1":
    sys.exit(1)
if os.environ.get("FAKE_INSTALL_DELAY") != "never":
    delay = os.environ.get("FAKE_INSTALL_DELAY", "2")
    code = ("import sys,time,os\nsys.path.insert(0,%r)\nimport _phone\ntime.sleep(%s)\n"
            "a=_phone.manifest_attrs(%r)\nst=_phone.load()\nold=st.get(a['package'],{})\n"
            "if os.environ.get('FAKE_REFUSE')!='1':\n"
            "  st[a['package']]={'versionCode':a['versionCode'],'versionName':a['versionName'],'abi':old.get('abi','arm64-v8a'),'cert':old.get('cert','')}\n"
            "  _phone.save(st)\n") % (os.path.dirname(os.path.abspath(__file__)), delay, apk)
    subprocess.Popen([sys.executable, "-c", code], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
